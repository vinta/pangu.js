{
  "name": "pangu-examples",
  "version": "1.0.0",
  "description": "pangu.js Example app",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:commonjs && npm run verify:esm && npm run verify:cli && npm run verify:browser && npm run typecheck",
    "verify:commonjs": "node verify-commonjs.js",
    "verify:esm": "node verify-esm.mjs",
    "verify:cli": "node verify-cli.js",
    "verify:browser": "node verify-browser.js",
    "server": "node server.js"
  },
  "dependencies": {
    "pangu": "10.0.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "playwright": "1.61.1"
  }
}
