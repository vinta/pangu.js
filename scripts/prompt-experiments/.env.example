# Copy to .env.local after verifying it is ignored and untracked.
# HTTP CDP endpoint for your dedicated Chrome instance; no browser-session UUID.
PANGU_CDP_URL=http://127.0.0.1:PORT
# Exact Profile Path from chrome://version in the extension's profile.
PANGU_CHROME_PROFILE_PATH=/absolute/path/to/chrome-user-data/Default
# Profile display name from Chrome's profile menu (verified against Local State).
PANGU_CHROME_PROFILE_NAME="Experiment profile"
# Unpacked pangu extension ID from chrome://extensions with Developer mode on.
PANGU_EXTENSION_ID=REPLACE_WITH_EXTENSION_ID
