{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run build >/dev/null || exit 2",
            "if": "Edit(/src/**)",
            "timeout": 60,
            "statusMessage": "Building core..."
          },
          {
            "type": "command",
            "command": "npm run build >/dev/null || exit 2",
            "if": "Write(/src/**)",
            "timeout": 60,
            "statusMessage": "Building core..."
          },
          {
            "type": "command",
            "command": "npm run build >/dev/null || exit 2",
            "if": "Edit(/browser-extensions/**)",
            "timeout": 60,
            "statusMessage": "Building extensions..."
          },
          {
            "type": "command",
            "command": "npm run build >/dev/null || exit 2",
            "if": "Write(/browser-extensions/**)",
            "timeout": 60,
            "statusMessage": "Building extensions..."
          }
        ]
      }
    ]
  }
}
