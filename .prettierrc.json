{
  "printWidth": 200,
  "singleQuote": true,
  "quoteProps": "consistent",
  "htmlWhitespaceSensitivity": "strict",
  "organizeImportsSkipDestructiveCodeActions": true,
  "plugins": [
    "prettier-plugin-organize-imports"
  ],
  "overrides": [
    {
      "files": "**/*.json",
      "options": {
        "parser": "json-stringify"
      }
    },
    {
      "files": "**/tsconfig*.json",
      "options": {
        "parser": "jsonc"
      }
    }
  ]
}
